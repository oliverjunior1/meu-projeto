from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.common.keys import Keys
from selenium.webdriver.chrome.service import Service
from webdriver_manager.chrome import ChromeDriverManager
import time

# =========================
# CONFIGURAÇÕES
# =========================

USUARIO = "SEU_CPF_OU_MATRICULA"
SENHA = "SUA_SENHA"

# =========================
# INICIA NAVEGADOR
# =========================

driver = webdriver.Chrome(
    service=Service(ChromeDriverManager().install())
)

driver.maximize_window()

# =========================
# ACESSA O PORTAL
# =========================

driver.get("https://acessoseguro.sso.caixa.gov.br/portal")

time.sleep(5)

# =========================
# LOGIN
# =========================

campo_usuario = driver.find_element(By.ID, "username")
campo_usuario.send_keys(USUARIO)

campo_senha = driver.find_element(By.ID, "password")
campo_senha.send_keys(SENHA)

campo_senha.send_keys(Keys.ENTER)

time.sleep(10)

# =========================
# NAVEGAÇÃO
# =========================
# Ajuste os seletores conforme o portal atual

driver.get("https://soucaixa.caixa.gov.br")

time.sleep(10)

# Exemplo genérico:
# procura área de holerite

holerites = driver.find_elements(By.CLASS_NAME, "holerite-item")

if holerites:
    ultimo = holerites[0].text
    print("Último holerite disponível:")
    print(ultimo)
else:
    print("Nenhum holerite encontrado.")

# =========================
# FINALIZA
# =========================

input("Pressione ENTER para fechar...")
driver.quit()